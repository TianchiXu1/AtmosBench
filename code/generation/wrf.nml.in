&time_control
 run_hours=30, start_year=${SY},start_month=${SM},start_day=${SD},start_hour=${SHH},
 end_year=${EY},end_month=${EM},end_day=${ED},end_hour=${EH}, interval_seconds=21600, input_from_file=.true.,
 history_interval=60, frames_per_outfile=1, restart=.false.,
 io_form_history=2,io_form_restart=2,io_form_input=2,io_form_boundary=2,
/
&domains
 time_step=${DT}, max_dom=1, e_we=221, e_sn=221, e_vert=200, dzstretch_s=1.1, p_top_requested=5000, auto_levels_opt=2,
 num_metgrid_levels=${NMET}, num_metgrid_soil_levels=4, dx=1000, dy=1000, grid_id=1, parent_id=0,
/
&physics
 physics_suite="CONUS", mp_physics=10, cu_physics=0, ra_lw_physics=4, ra_sw_physics=4, bl_pbl_physics=1, sf_sfclay_physics=1, sf_surface_physics=2, radt=10, bldt=0, cudt=0, icloud=1, num_land_cat=21,
/
&dynamics
 hybrid_opt=2, w_damping=1, diff_opt=2, km_opt=4, damp_opt=3, zdamp=5000., dampcoef=0.2, epssm=0.5, non_hydrostatic=.true., moist_adv_opt=1, scalar_adv_opt=1,
/
&bdy_control
 spec_bdy_width=5, spec_zone=1, relax_zone=4, specified=.true., nested=.false.,
/
&namelist_quilt
 nio_tasks_per_group=0, nio_groups=1,
/
